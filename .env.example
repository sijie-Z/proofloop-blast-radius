# Copy to .env and fill in your Vultr Serverless Inference API key.
# Never commit .env; it is gitignored.
VULTR_INFERENCE_API_KEY=your_key_here

# Optional overrides
# VULTR_MODEL=deepseek-v4.1-flash-1017
# VULTR_BASE_URL=https://api.vultrinference.com/v1
# HTTPS proxy for networks where api.vultrinference.com is not directly reachable
# VULTR_PROXY=http://127.0.0.1:7897
