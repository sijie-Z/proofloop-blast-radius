[Unit]
Description=ProofLoop Blast Radius Zero web control plane
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=proofloop
Group=proofloop
WorkingDirectory=/opt/proofloop-blast-radius
EnvironmentFile=/etc/proofloop/proofloop.env
ExecStart=/opt/proofloop-blast-radius/.venv/bin/uvicorn webapp.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
